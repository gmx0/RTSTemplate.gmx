        <arguments>
          <argument>
            <kind>1</kind>
            <string>var click;
click=point_distance(x,y,player_select_x,player_select_y)&lt;8;
with(obj_unit) if unit_owner==other.id &amp;&amp; rts_visible(other.id,id) {
 if (click &amp;&amp; point_distance(x,y,other.x,other.y)&lt;=18) ||
 (!click &amp;&amp; x&lt;=max(other.x,other.player_select_x) &amp;&amp; y&lt;=max(other.y,other.player_select_y) &amp;&amp; x&gt;=min(other.x,other.player_select_x) &amp;&amp; y&gt;=min(other.y,other.player_select_y)) {
  unit_select=true; ds_list_add(other.player_select,id);
 }
}
player_state=player_states.plyr_idle;
</string>
          </argument>
        </arguments>
      </action>
    </event>
